MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=oria_exam_supplies
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@oriaexamsupplies.co.ke

# M-Pesa (Safaricom Daraja). Leave empty to switch payments off.
# MPESA_ENV is "sandbox" for testing or "production" for real money.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Oria's Paybill is 679013 (use 174379 while testing in sandbox).
MPESA_SHORTCODE=
MPESA_PASSKEY=
# "paybill" or "till". For a till, also set the till number.
MPESA_TYPE=paybill
MPESA_TILL_NUMBER=

# Printing quote email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
